# Database Configuration
# SQLite (Local Development)
DATABASE_URL="file:./dev.db"

# PostgreSQL (Production)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/homecare247?schema=public"

# Server Port
PORT=4000

# JWT Auth
JWT_SECRET="replace_with_your_strong_random_secret_string"
JWT_EXPIRES_IN="7d"

# File Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# CORS Allowed Origins
FRONTEND_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:5173"

